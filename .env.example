# Copiar a .env y reemplazar los valores antes de ejecutar `docker compose up -d`.
# En EC2 deja NGINX_PORT=80 (único puerto expuesto al exterior); en local puedes usar 8080 si el 80 está ocupado.
NGINX_PORT=80

# Base de datos y Django
POSTGRES_PASSWORD=volt-local-change-me
DJANGO_SECRET_KEY=volt-local-development-change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django

# Microservicio de Notificaciones
NOTIFICATIONS_API_KEY=volt-notifications-local-change-me

# Microservicio Chatbot (Flask + Celery + Redis + Gemini)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEXT_MODEL=gemini-3.8-flash
EMBEDDING_DIM=768
SIMILARITY_THRESHOLD=0.55
TOP_K=10
MAX_RESULTS=4
INTERNAL_API_KEY=volt-chatbot-internal-secret-change-me
CHATBOT_INTERNAL_API_KEY=volt-chatbot-internal-secret-change-me
CHATBOT_SYNC_URL=http://chatbot:5001/internal/products/sync
CHATBOT_SYNC_TIMEOUT=2.0

# Servicio aliado FinanSmart
# FINANSMART_BACKEND='fake' es solo para desarrollo y pruebas (muestra datos simulados sin red).
# Déjalo vacío para consumir el servicio real y configura FINANSMART_SUMMARY_URL y FINANSMART_TOKEN.
FINANSMART_BACKEND=
FINANSMART_SUMMARY_URL=http://finansmart:8000/api/v1/summary/
FINANSMART_TOKEN=
